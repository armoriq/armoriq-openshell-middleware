+/// Select the `PRE_RETURN` stages for a request the request chain allowed.
+///
+/// Returns `None` when no attached middleware advertises the response binding,
+/// which leaves the response relayed exactly as it is without one.
+pub async fn response_middleware_for<'a>(
+    chain: &[openshell_supervisor_middleware::ChainEntry],
+    runner: &'a openshell_supervisor_middleware::ChainRunner,
+    ctx: &L7EvalContext,
+    scheme: &str,
+    req: &crate::l7::provider::L7Request,
+) -> Option<crate::l7::rest::ResponseMiddleware<'a>> {
+    if chain.is_empty() {
+        return None;
+    }
+    let entries: Vec<_> = match runner.describe_http_response_chain(chain).await {
+        Ok(entries) => entries
+            .into_iter()
+            .filter(openshell_supervisor_middleware::DescribedChainEntry::is_resolved)
+            .collect(),
+        Err(error) => {
+            tracing::warn!(error = %error, "PRE_RETURN stages unavailable, response relayed unobserved");
+            return None;
+        }
+    };
+    if entries.is_empty() {
+        return None;
+    }
+    Some(crate::l7::rest::ResponseMiddleware {
+        runner,
+        entries,
+        scheme: scheme.to_string(),
+        host: ctx.host.clone(),
+        port: ctx.port,
+        workspace: ctx.workspace.clone(),
+        path: req.target.clone(),
+    })
+}
