+            assert!(
+                early.is_err(),
+                "client received bytes before the stage answered"
+            );
+
+            gate.notify_one();
+            tokio::time::timeout(std::time::Duration::from_secs(2), relay)
+                .await
+                .expect("relay finishes once released")
+                .expect("relay_response")
+        };
+        assert!(matches!(outcome, RelayOutcome::Reusable));
+
+        client_write.shutdown().await.unwrap();
+        let mut received = Vec::new();
+        client_read.read_to_end(&mut received).await.unwrap();
+        assert_eq!(received, response);
+        assert_eq!(bodies(&stages), vec![b"hello".to_vec()]);
+    }
+
+    #[tokio::test]
+    async fn a_chunked_reply_is_offered_without_framing_and_relayed_byte_for_byte() {
+        let response: &[u8] = b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nhello \r\n5\r\nworld\r\n0\r\nx-checksum: abc\r\n\r\n";
+        let stages = stages(4096, None);
+        let received = relay_held(response, &stages).await;
+        assert_eq!(
+            received, response,
+            "the client must get the upstream bytes unchanged"
+        );
+        assert_eq!(bodies(&stages), vec![b"hello world".to_vec()]);
+    }
+
+    #[tokio::test]
+    async fn a_chunked_reply_over_the_limit_is_delivered_intact_and_unobserved() {
+        let response: &[u8] = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n14\r\n01234567890123456789\r\n14\r\nabcdefghijabcdefghij\r\n0\r\n\r\n";
+        let stages = stages(16, None);
+        let received = relay_held(response, &stages).await;
+        assert_eq!(received, response);
+        assert!(bodies(&stages).is_empty(), "an over-limit body was offered");
+    }
+
+    #[tokio::test]
+    async fn a_known_length_over_the_limit_is_not_held() {
+        let response: &[u8] = b"HTTP/1.1 200 OK\r\nContent-Length: 20\r\n\r\n01234567890123456789";
+        let stages = stages(16, None);
+        let received = relay_held(response, &stages).await;
+        assert_eq!(received, response);
+        assert!(bodies(&stages).is_empty());
+    }
+
+    #[tokio::test]
+    async fn an_encoded_reply_is_not_held() {
+        let response: &[u8] =
+            b"HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: 5\r\n\r\nhello";
+        let stages = stages(4096, None);
+        let received = relay_held(response, &stages).await;
+        assert_eq!(received, response);
+        assert!(
+            bodies(&stages).is_empty(),
+            "stages cannot read an encoded body"
+        );
+    }
+
+    #[test]
+    fn dechunk_strips_framing_extensions_and_trailers() {
+        assert_eq!(
+            dechunk(b"3;ext=1\r\nabc\r\n2\r\nde\r\n0\r\nx: y\r\n\r\n"),
+            Some(b"abcde".to_vec())
+        );
+        assert_eq!(dechunk(b"0\r\n\r\n"), Some(Vec::new()));
+        assert_eq!(dechunk(b"5\r\nab"), None);
+    }
+
+    #[test]
+    fn preflight_headers_withhold_hop_by_hop_and_cookies() {
+        let headers = middleware_response_headers(
+            "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nSet-Cookie: s=1\r\nConnection: keep-alive\r\nX-Request-Id: r1\r\n\r\n",
+        );
+        assert_eq!(
+            headers,
+            vec![
+                ("content-type".to_string(), "application/json".to_string()),
+                ("x-request-id".to_string(), "r1".to_string()),
+            ]
+        );
+    }
+}
