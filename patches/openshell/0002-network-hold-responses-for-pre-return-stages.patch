+/// Hold one response until its `PRE_RETURN` stages have seen it, then relay it
+/// byte for byte.
+///
+/// Nothing reaches the sandbox before the stages finish. A stage that reads the
+/// reply to learn what the workload will do next has to be done before the
+/// workload can act on it, or its next request is judged against stale state.
+///
+/// Returns `None` when the response cannot be held, and the caller relays it as
+/// it would without a response-bound middleware.
+#[allow(clippy::too_many_arguments)]
+async fn observe_and_relay_response<U, C>(
+    response: &ResponseMiddleware<'_>,
+    request_method: &str,
+    status_code: u16,
+    buf: &[u8],
+    header_end: usize,
+    body_length: BodyLength,
+    upstream: &mut U,
+    client: &mut C,
+) -> Result<Option<RelayOutcome>>
+where
+    U: AsyncRead + Unpin,
+    C: AsyncWrite + Unpin,
+{
+    let limit = response.hold_limit();
+    let overflow = &buf[header_end..];
+    let (raw, body) = match body_length {
+        BodyLength::ContentLength(len) => {
+            let Ok(len) = usize::try_from(len) else {
+                return Ok(None);
+            };
+            if len > limit {
+                return Ok(None);
+            }
+            let mut raw = overflow.to_vec();
+            let remaining = len.saturating_sub(raw.len());
+            if remaining > 0 {
+                relay_fixed(upstream, &mut raw, remaining as u64, None).await?;
+            }
+            let body = raw[..len.min(raw.len())].to_vec();
+            (raw, body)
+        }
+        BodyLength::Chunked => {
+            let mut held = HeldBody {
+                bytes: overflow.to_vec(),
+                limit,
+                over_limit: false,
+            };
+            if let Err(error) = relay_chunked(upstream, &mut held, overflow, None).await {
+                if !held.over_limit {
+                    return Err(error);
+                }
+                // Too large to offer any stage. Deliver what was read, then relay
+                // the rest as it arrives, re-parsing from what was already sent.
+                client
+                    .write_all(&buf[..header_end])
+                    .await
+                    .into_diagnostic()?;
+                client.write_all(&held.bytes).await.into_diagnostic()?;
+                relay_chunked(upstream, client, &held.bytes, None).await?;
+                client.flush().await.into_diagnostic()?;
+                return Ok(Some(RelayOutcome::Reusable));
+            }
+            let body = dechunk(&held.bytes).unwrap_or_default();
+            (held.bytes, body)
+        }
+        BodyLength::None => return Ok(None),
+    };
+
+    let header_str = String::from_utf8_lossy(&buf[..header_end]);
+    let sandbox = ocsf_ctx();
+    let input = openshell_supervisor_middleware::HttpResponseInput {
+        request_id: uuid::Uuid::new_v4().to_string(),
+        sandbox_id: sandbox.sandbox_id.clone(),
+        sandbox_name: sandbox.sandbox_name.clone(),
+        workspace: response.workspace.clone(),
+        scheme: response.scheme.clone(),
+        host: response.host.clone(),
+        port: response.port,
+        method: request_method.to_string(),
+        path: response.path.clone(),
+        status_code: u32::from(status_code),
+        headers: middleware_response_headers(&header_str),
+        body,
+    };
+    for (middleware, outcome) in response
+        .runner
+        .observe_http_response(&response.entries, &input)
+        .await
+    {
+        debug!(%middleware, ?outcome, status_code, "PRE_RETURN stage");
+    }
+
+    client
+        .write_all(&buf[..header_end])
+        .await
+        .into_diagnostic()?;
+    client.write_all(&raw).await.into_diagnostic()?;
+    client.flush().await.into_diagnostic()?;
+    Ok(Some(RelayOutcome::Reusable))
+}
+
+/// Collects a response body up to a limit.
+///
+/// Every byte it is handed is kept, including the write that crosses the limit,
+/// so a response that turns out too large is still delivered intact.
+struct HeldBody {
+    bytes: Vec<u8>,
+    limit: usize,
+    over_limit: bool,
+}
+
+impl AsyncWrite for HeldBody {
+    fn poll_write(
+        mut self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+        data: &[u8],
+    ) -> std::task::Poll<std::io::Result<usize>> {
+        self.bytes.extend_from_slice(data);
+        if self.bytes.len() > self.limit {
+            self.over_limit = true;
+            return std::task::Poll::Ready(Err(std::io::Error::other(
+                "held response exceeds the middleware payload limit",
+            )));
+        }
+        std::task::Poll::Ready(Ok(data.len()))
+    }
+
+    fn poll_flush(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<std::io::Result<()>> {
+        std::task::Poll::Ready(Ok(()))
+    }
+
+    fn poll_shutdown(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<std::io::Result<()>> {
+        std::task::Poll::Ready(Ok(()))
+    }
+}
+
+/// The payload of a complete chunked message, without framing or trailers.
+fn dechunk(raw: &[u8]) -> Option<Vec<u8>> {
+    let mut body = Vec::new();
+    let mut pos = 0;
+    loop {
+        let line_end = find_crlf(raw, pos)?;
+        let line = std::str::from_utf8(&raw[pos..line_end]).ok()?;
+        let size = usize::from_str_radix(line.split(';').next()?.trim(), 16).ok()?;
+        pos = line_end + 2;
+        if size == 0 {
+            return Some(body);
+        }
+        let end = pos.checked_add(size)?;
+        body.extend_from_slice(raw.get(pos..end)?);
+        pos = end.checked_add(2)?;
+    }
+}
+
+/// A body stages cannot read without decoding it first. The contract offers
+/// these only headers-only, and this observe path does not decode.
+fn response_is_content_encoded(headers: &str) -> bool {
+    headers.lines().skip(1).any(|line| {
+        line.split_once(':').is_some_and(|(name, value)| {
+            name.trim().eq_ignore_ascii_case("content-encoding")
+                && !value.trim().eq_ignore_ascii_case("identity")
+        })
+    })
+}
+
+/// Response headers for a preflight, in wire order, without hop-by-hop fields
+/// or cookies.
+fn middleware_response_headers(headers: &str) -> Vec<(String, String)> {
+    const WITHHELD: &[&str] = &[
+        "connection",
+        "keep-alive",
+        "proxy-authenticate",
+        "proxy-connection",
+        "set-cookie",
+        "te",
+        "trailer",
+        "transfer-encoding",
+        "upgrade",
+    ];
+    headers
+        .lines()
+        .skip(1)
+        .filter_map(|line| line.split_once(':'))
+        .map(|(name, value)| (name.trim().to_ascii_lowercase(), value.trim().to_string()))
+        .filter(|(name, _)| !name.is_empty() && !WITHHELD.contains(&name.as_str()))
+        .collect()
+}
