+/// `PRE_RETURN` stages selected for one request the request chain allowed, and
+/// what a preflight needs that the response itself does not carry.
+pub(crate) struct ResponseMiddleware<'a> {
+    pub(crate) runner: &'a openshell_supervisor_middleware::ChainRunner,
+    pub(crate) entries: Vec<openshell_supervisor_middleware::DescribedChainEntry>,
+    pub(crate) scheme: String,
+    pub(crate) host: String,
+    pub(crate) port: u16,
+    pub(crate) workspace: String,
+    pub(crate) path: String,
+}
+
+impl ResponseMiddleware<'_> {
+    /// The most any stage accepts as a whole body. Nothing larger can be
+    /// offered, so it is relayed without being held.
+    fn hold_limit(&self) -> usize {
+        self.entries
+            .iter()
+            .map(openshell_supervisor_middleware::DescribedChainEntry::max_payload_bytes)
+            .max()
+            .unwrap_or(0)
+            .min(openshell_supervisor_middleware::MAX_MIDDLEWARE_PAYLOAD_BYTES)
+    }
 }
 
